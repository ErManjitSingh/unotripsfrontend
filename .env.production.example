# Copy to .env.production before npm run build for live deploy.
# Do NOT use localhost — it gets baked into SEO metadata.

NEXT_PUBLIC_SITE_URL=https://unotrips.com
NEXT_PUBLIC_API_URL=https://website.travelwithuno.com
HOTELS_API_URL=http://localhost:8000
NEXT_PUBLIC_HOTELS_API_URL=http://localhost:8000
# Browser MUST use proxy — never call Render URL directly from components
NEXT_PUBLIC_API_BASE=/api/hotels

# Digital marketing measurement. Keep these IDs public; never put ad-platform API secrets in Next.js env vars.
# A consent banner loads these only after the visitor opts in.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_CAB_BOOKING_CONVERSION_LABEL=YOUR_CONVERSION_LABEL
NEXT_PUBLIC_META_PIXEL_ID=YOUR_META_PIXEL_ID
# Optional common Google tag ID when Analytics and Ads are connected to a GT-* tag.
NEXT_PUBLIC_GOOGLE_TAG_ID=GT-XXXXXXXXXX
# Optional session replay / heatmaps. Load only after analytics consent.
NEXT_PUBLIC_MICROSOFT_CLARITY_PROJECT_ID=YOUR_CLARITY_PROJECT_ID
